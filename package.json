{
  "name": "@pitchmentor/mcp",
  "version": "0.1.1",
  "description": "Official MCP server (stdio) for the Pitch Mentor API: gives AI assistants one tool per API operation.",
  "type": "module",
  "bin": {
    "pitchmentor-mcp": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pitchmentor/pitchmentor-mcp.git"
  },
  "homepage": "https://pitchmentor.net/docs",
  "bugs": {
    "url": "https://github.com/pitchmentor/pitchmentor-mcp/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@pitchmentor/sdk": "^0.1.1"
  },
  "keywords": [
    "pitchmentor",
    "pitch-mentor",
    "sales-coaching",
    "mcp",
    "model-context-protocol",
    "ai-agent"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
